soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/qcom-caf/common/libqti-perfd-client"
    ],
}

prebuilt_etc {
    name: "default-permissions-com.google.android.euicc.xml",
    src: "configs/permissions/default-permissions-com.google.android.euicc.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-com.google.android.euicc.xml",
    src: "configs/permissions/privapp-permissions-com.google.android.euicc.xml",
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-qti-telephony-service.xml",
    src: "configs/permissions/privapp-permissions-qti-telephony-service.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-qti-qcc.xml",
    src: "configs/permissions/privapp-permissions-qti-qcc.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-qti-data-status.xml",
    src: "configs/permissions/privapp-permissions-qti-data-status.xml",
    sub_dir: "permissions",
    product_specific: true,
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wcn7750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wcn7750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/wcn7750/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "metroid_mountpoint_firmware_mnt",
    vendor: true,
    installed_location: "firmware_mnt/.mountpoint",
    symlink_target: "/dev/null",
}

install_symlink {
    name: "metroid_mountpoint_dsp",
    vendor: true,
    installed_location: "dsp/.mountpoint",
    symlink_target: "/dev/null",
}

install_symlink {
    name: "metroid_mountpoint_bt_firmware",
    vendor: true,
    installed_location: "bt_firmware/.mountpoint",
    symlink_target: "/dev/null",
}
