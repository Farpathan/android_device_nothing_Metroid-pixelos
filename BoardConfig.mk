DEVICE_PATH := device/nothing/Metroid

# Inherit Common BoardConfig
-include $(DEVICE_PATH)/BoardConfigCommon.mk

# Display
TARGET_SCREEN_DENSITY := 480
TARGET_SCREEN_HEIGHT := 2800
TARGET_SCREEN_WIDTH := 1260
TARGET_USES_VULKAN := true

# Partitions - Exact Sizes from Live Device (Nothing Phone 3 / A024)
BOARD_FLASH_BLOCK_SIZE := 262144 # (BOARD_KERNEL_PAGESIZE * 64)
BOARD_BOOTIMAGE_PARTITION_SIZE := 100663296
BOARD_PVMFWIMAGE_PARTITION_SIZE := 1048576
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 104857600
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 100663296
BOARD_DTBOIMG_PARTITION_SIZE := 52428800
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 8388608
BOARD_SUPER_PARTITION_SIZE := 9663676416
BOARD_NOTHING_DYNAMIC_PARTITIONS_SIZE := 9659482112
BOARD_QUALCOMM_DYNAMIC_PARTITIONS_SIZE := $(BOARD_NOTHING_DYNAMIC_PARTITIONS_SIZE)

# Properties
TARGET_SYSTEM_PROP += $(DEVICE_PATH)/system.prop
TARGET_VENDOR_PROP += $(DEVICE_PATH)/vendor.prop
TARGET_PRODUCT_PROP += $(DEVICE_PATH)/product.prop
TARGET_SYSTEM_EXT_PROP += $(DEVICE_PATH)/system_ext.prop
TARGET_ODM_PROP += $(DEVICE_PATH)/odm.prop

# Vendor BoardConfig
-include vendor/nothing/Metroid/BoardConfigVendor.mk

# Lineage BoardConfig
-include vendor/lineage/config/BoardConfigLineage.mk
