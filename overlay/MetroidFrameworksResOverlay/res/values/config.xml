    <!-- UDFPS sensor location (x, y, radius) in native 1260x2800 px.
         Derived by the previous attempt from the live HAL: getSensorProps()
         reports 540/2176/92 in 1080x2400 space; this panel has no 1080p mode,
         so scale by 7/6: 630/2539/107. x=630 matches the cutout centre. -->
    <integer-array name="config_udfps_sensor_props" translatable="false">
        <item>630</item>
        <item>2539</item>
        <item>107</item>
    </integer-array>

    <!-- Default the panel to 120 Hz, matching stock. Required for the optical
         UDFPS: the panel driver refuses local HBM unless already at 120 Hz.
         config_defaultRefreshRate is deliberately left at the AOSP default. -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
