<resources>
    <!-- Stock enables the device-side IMS capabilities. CarrierConfig remains
         authoritative for per-carrier admission. -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>

    <!-- Qualcomm's IWLAN service supplies the WLAN data, registration, and
         qualified-network implementations backed by the modem IWlan HALs. -->
    <string name="config_wlan_data_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_wlan_network_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_qualified_networks_service_package" translatable="false">vendor.qti.iwlan</string>

    <!-- Stock NothingOS lux-to-backlight mapping. -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>30</item>
        <item>60</item>
        <item>100</item>
        <item>150</item>
        <item>210</item>
        <item>255</item>
    </integer-array>
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>10</item>
        <item>20</item>
        <item>40</item>
        <item>70</item>
        <item>110</item>
        <item>160</item>
        <item>200</item>
        <item>255</item>
    </integer-array>

    <!-- Enable UDC sysfs USB state update so UsbDeviceManager can monitor
         /sys/class/udc/<udc>/state on configfs-only HAL devices. -->
    <bool name="config_enableUdcSysfsUsbStateUpdate">true</bool>

    <!-- Default to gestural navigation (no setup wizard runs to set it). -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- Create the (invisible) navigation bar. Without this, SystemUI never
         builds the NavigationBar window that hosts the back gesture handler
         and the back swipe does not register (verified by the previous
         attempt on the live device). -->
    <bool name="config_showNavigationBar">true</bool>

