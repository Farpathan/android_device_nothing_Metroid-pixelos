on init
    # Property used for sku specific sysconfig and permissions
    setprop ro.boot.product.hardware.sku ${ro.boot.hardware.sku}

on fs
#ifdef NT_EDIT
# NT_EDIT added for ARBOK-149: add for arbok speaker calib
    mkdir /mnt/vendor/persist/audio 0777 system system
# BSP Audio Zhang.liu 20221108 add for smartpa-cali, begin
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0034/reg
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0034/rw
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0034/name
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0035/reg
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0035/rw
    chmod 666 /sys/bus/i2c/drivers/tfa98xx/5-0035/name
# BSP Audio Zhang.liu 20221108 add for smartpa-cali, end
#endif

