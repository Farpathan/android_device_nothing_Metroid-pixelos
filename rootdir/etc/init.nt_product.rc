on charger
##NT,start charge sevice
    start vendor.charge-default-poweroff

##NT,start charge service
service vendor.charge-default-poweroff /vendor/bin/hw/vendor.noth.hardware.charge-service
    class core
    group system
    disabled
##Stop charge sevice

# ifdef NT_EDIT
# modify to diag instruction
on property:sys.boot_completed=1
    start ft_diag_test

service ft_diag_test /vendor/bin/ft_diag_test
   class main
   user root
   group system

#nt add system group for charger node@{
on property:sys.boot_completed=1
    # add for runin to write charger
    chown system system /sys/class/qcom-battery/usb_charger_en
    chmod 0666 /sys/class/qcom-battery/usb_charger_en
    chown system system /sys/class/qcom-battery/charge_control_en
    chmod 0666  /sys/class/qcom-battery/charge_control_en
    chown system system /sys/class/qcom-battery/charge_pump_enable
    chmod 0666 /sys/class/qcom-battery/charge_pump_enable
    chown system system /sys/class/qcom-battery/charge_power
    chmod 0666 /sys/class/qcom-battery/charge_power
    chown system system /sys/class/qcom-battery/ship_mode_en
    chmod 0666 /sys/class/qcom-battery/ship_mode_en
    chown system system /sys/class/qcom-battery/typec_cc_orientation
    chmod 0666 /sys/class/qcom-battery/typec_cc_orientation
    # add for cit to write wireless_boost_en
    chown system system /sys/class/qcom-battery/wireless_boost_en
    chmod 0666 /sys/class/qcom-battery/wireless_boost_en
    # add for cit to write wls_cp_reg
    chown system system /sys/class/qcom-battery/wls_cp_reg
    chmod 0666 /sys/class/qcom-battery/wls_cp_reg
    # add for cit to write wls_cp_data
    chown system system /sys/class/qcom-battery/wls_cp_data
    chmod 0666 /sys/class/qcom-battery/wls_cp_data
    # add for wireless charge to write scenario_fcc
    chown system system /sys/class/qcom-battery/scenario_fcc
    chmod 0666 /sys/class/qcom-battery/scenario_fcc
    chown system system /sys/class/qcom-battery/charge_exist_pump
    chmod 0644 /sys/class/qcom-battery/charge_exist_pump
    chown system system /sys/class/qcom-battery/charge_exist_buck
    chmod 0644 /sys/class/qcom-battery/charge_exist_buck
    chown system system /sys/class/qcom-battery/charge_exist_wls
    chmod 0644 /sys/class/qcom-battery/charge_exist_wls

    chown system system /proc/charger/battery_health
    chown system system /proc/charger/charge_buck_enable
    chown system system /proc/charger/charge_dump_reg
    chown system system /proc/charger/charge_exist_buck
    chown system system /proc/charger/charge_exist_pump
    chown system system /proc/charger/charge_exist_wls
    chown system system /proc/charger/charge_pump_enable
    chown system system /proc/charger/chg_data_id
    chown system system /proc/charger/is_aging_test
    chown system system /proc/charger/nt_abnormal_status
    chown system system /proc/charger/nt_adp_power
    chown system system /proc/charger/nt_data
    chown system system /proc/charger/nt_fake_ibat
    chown system system /proc/charger/nt_fake_soc
    chown system system /proc/charger/nt_fake_tbat
    chown system system /proc/charger/nt_fake_tusb
    chown system system /proc/charger/nt_fake_vbat
    chown system system /proc/charger/nt_otg_enable
    chown system system /proc/charger/nt_qmax
    chown system system /proc/charger/nt_quse
    chown system system /proc/charger/nt_resistance
    chown system system /proc/charger/scenario_fcc
    chown system system /proc/charger/ship_mode
    chown system system /proc/charger/temp
    chown system system /proc/charger/typec_cc_orientation
    chown system system /proc/charger/usb_charger_en
    chown system system /proc/charger/usb_real_type
    chown system system /proc/charger/usb_temp
    chown system system /proc/charger/voltage_adc

    restorecon /sys/class/qcom-battery/usb_real_type
    restorecon /sys/class/qcom-battery/wireless_boost_en
    restorecon /sys/class/qcom-battery/wls_reverse_status
    restorecon /sys/class/qcom-battery/wireless_fw_version

on property:sys.boot_completed=1 && property:sys.runin.charging=false
    write /sys/class/qcom-battery/usb_charger_en 0
on property:sys.boot_completed=1 && property:sys.runin.charging=true
    write /sys/class/qcom-battery/usb_charger_en 1
# @}
# change by NT@{
on property:sys.boot_completed=1 && property:sys.service.ageTest_running.upload.enable=false
    write /proc/charger/is_aging_test 0
on property:sys.boot_completed=1 && property:sys.service.ageTest_running.upload.enable=true
    write /proc/charger/is_aging_test 1
on property:sys.boot_completed=1 && property:sys.service.ntmonkey.run=false
    write /proc/charger/is_aging_test 0
on property:sys.boot_completed=1 && property:sys.service.ntmonkey.run=true
    write /proc/charger/is_aging_test 1
# @}
#endif /* NT_EDIT */

# pohsiang add for touch.
on property:sys.touch.game_mode.enable=*
    write /proc/touchpanel/game_mode ${sys.touch.game_mode.enable}
on property:sys.touch.edge_mode.enable=*
    write /proc/touchpanel/edge_mode ${sys.touch.edge_mode.enable}
on property:sys.touch.fod_en.enable=*
    write /proc/touchpanel/fod_mode ${sys.touch.fod_en.enable}
on property:sys.touch.single_en.enable=*
    write /proc/touchpanel/gesture_mode ${sys.touch.single_en.enable}
on property:sys.touch.fp_status=*
    write /sys/panel_feature/fp_status ${sys.touch.fp_status}
on property:sys.touch.pocket_mode=*
    write /proc/touchpanel/pocket_mode ${sys.touch.pocket_mode}


on property:sys.otg.enable=1
    write /sys/dev/block/${sys.otg.devid}/queue/read_ahead_kb 2048
    write /dev/sys/block/by-name/userdata/queue/read_ahead_kb 2048
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 100000
    write /sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us 100000
    write /sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us 100000
    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 100000
    write /dev/cpuctl/top-app/cpu.uclamp.min 100
    write /dev/cpuctl/foreground/cpu.uclamp.min 50

on property:sys.otg.enable=0
    write /dev/sys/block/by-name/userdata/queue/read_ahead_kb 512
    write /sys/devices/system/cpu/cpufreq/policy7/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy5/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy2/walt/down_rate_limit_us 0
    write /sys/devices/system/cpu/cpufreq/policy0/walt/down_rate_limit_us 0
    write /dev/cpuctl/top-app/cpu.uclamp.min 0
    write /dev/cpuctl/foreground/cpu.uclamp.min 0

on post-fs-data
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/camera 0777 cameraserver cameraserver
    mkdir /data/vendor/camera 0775 camera camera
    chmod 0444 /mnt/vendor/persist/camera/bokeh_caldata_uw_persist.bin
    copy  /mnt/vendor/persist/camera/bokeh_caldata_uw_persist.bin /data/vendor/camera/bokeh_caldata_uw_persist.bin
    chmod 0444 /data/vendor/camera/bokeh_caldata_uw_persist.bin
    chown cameraserver audio /data/vendor/camera/bokeh_caldata_uw_persist.bin

    chmod 0444 /mnt/vendor/persist/camera/bokeh_caldata_tele_persist.bin
    copy /mnt/vendor/persist/camera/bokeh_caldata_tele_persist.bin /data/vendor/camera/bokeh_caldata_tele_persist.bin
    chmod 0444 /data/vendor/camera/bokeh_caldata_tele_persist.bin
    chown cameraserver audio /data/vendor/camera/bokeh_caldata_tele_persist.bin

    chmod 0777 /vendor/etc/camera
    copy /vendor/etc/camera/bokeh_caldata_uw_golden.bin /data/vendor/camera/bokeh_caldata_uw_golden.bin
    chmod 0444 /data/vendor/camera/bokeh_caldata_uw_golden.bin
    chown cameraserver audio /data/vendor/camera/bokeh_caldata_uw_golden.bin

    copy /vendor/etc/camera/bokeh_caldata_tele_golden.bin /data/vendor/camera/bokeh_caldata_tele_golden.bin
    chmod 0444 /data/vendor/camera/bokeh_caldata_tele_golden.bin
    chown cameraserver audio /data/vendor/camera/bokeh_caldata_tele_golden.bin

on property:sys.touch.keyguard.state=*
    write /proc/touchpanel/palm_to_sleep_support ${sys.touch.keyguard.state}
