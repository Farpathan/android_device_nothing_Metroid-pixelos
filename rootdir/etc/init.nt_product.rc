#NT_EDIT added for ARBOK-206: add for arbok fingerprint
#Nothing add for Fingerprint dump ARBOK-191
    mkdir data/vendor/fpdump 0777 system system
    restorecon /data/vendor/fpdump
# endif

    chmod 770 /proc/cpu_monitor/
    chown system system /proc/cpu_monitor/
    chmod 770 /proc/cpu_monitor/enable_monitor
    chown system system /proc/cpu_monitor/enable_monitor
    chmod 770 /proc/cpu_monitor/target_pid
    chown system system /proc/cpu_monitor/target_pid
    chmod 770 /proc/cpu_monitor/period_ms
    chown system system /proc/cpu_monitor/period_ms
