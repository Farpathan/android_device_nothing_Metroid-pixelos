DEVICE_PATH := device/nothing/Metroid

# Enable project quotas and casefolding for emulated storage without sdcardfs
$(call inherit-product, $(SRC_TARGET_DIR)/product/emulated_storage.mk)

# GSI AVB keys, moved into vendor_boot by BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT
$(call inherit-product, $(SRC_TARGET_DIR)/product/gsi_keys.mk)

# Dynamic partitions
PRODUCT_USE_DYNAMIC_PARTITIONS := true

# Virtual A/B with compression
$(call inherit-product, $(SRC_TARGET_DIR)/product/virtual_ab_ota/vabc_features.mk)
PRODUCT_VIRTUAL_AB_COMPRESSION_METHOD := lz4
PRODUCT_VIRTUAL_AB_COW_VERSION := 3

# Soong namespaces. The sm8750 caf repos (display core/hal/intf, audio) declare
# no soong_namespace of their own, so their modules are globally visible and
# need no entry here (same as the OnePlus sm8750-common tree).
PRODUCT_SOONG_NAMESPACES += \
    $(DEVICE_PATH) \
    hardware/google/interfaces \
    hardware/google/pixel

# QCOM caf common config (linker fragments, RFS symlinks)
$(call inherit-product, hardware/qcom-caf/common/common.mk)

# Relaxed checks for qcom blobs
RELAX_USES_LIBRARY_CHECK := true

# A/B updater packages
PRODUCT_PACKAGES += \
    update_engine \
    update_engine_client \
    update_engine_sideload \
    update_verifier

# Boot control HAL (hardware/qcom-caf/bootctrl)
PRODUCT_PACKAGES += \
    android.hardware.boot@1.2-impl-qti \
    android.hardware.boot@1.2-impl-qti.recovery \
    android.hardware.boot@1.2-service \
    android.hardware.boot-service.qti

# f2fs utilities and userdata checkpoint
PRODUCT_PACKAGES += \
    sg_write_buffer \
    f2fs_io \
    check_f2fs \
    checkpoint_gc

AB_OTA_POSTINSTALL_CONFIG += \
    RUN_POSTINSTALL_vendor=true \
    POSTINSTALL_PATH_vendor=bin/checkpoint_gc \
    FILESYSTEM_TYPE_vendor=erofs \
    POSTINSTALL_OPTIONAL_vendor=true

# fastbootd
PRODUCT_PACKAGES += \
    fastbootd \
    android.hardware.fastboot@1.1-impl-mock

# TEE / KeyMint dependencies
PRODUCT_PACKAGES += \
    android.hardware.health-V1-ndk \
    libxml2.vendor

# Display HALs from the sm8750 caf repos (hardware/qcom-caf/sm8750/display);
# module names confirmed in the synced tree. The composer-service module ships
# its own init rc and vintf fragment.
PRODUCT_PACKAGES += \
    vendor.qti.hardware.display.composer-service \
    vendor.qti.hardware.display.allocator-service \
    android.hardware.graphics.mapper@4.0-impl-qti-display

# Audio HAL support from the sm8750 caf repos (hardware/qcom-caf/sm8750/audio);
# module names confirmed in the synced tree.
PRODUCT_PACKAGES += \
    audioadsprpcd \
    libqcomvoiceprocessing \
    libvolumelistener

# TODO(hal): these exist in other sm8750 trees but are not yet confirmed for
# our manifest: vendor.qti.hardware.display.demura-service,
# vendor.qti.hardware.display.snapalloc-impl, audiohalservice.qti,
# qtiaudiohalvendorextn, libqti-perfd-client. Add them after verification.

# Rootdir (prebuilt_etc modules in rootdir/Android.bp, see rootdir/README.md)
PRODUCT_PACKAGES += \
    fstab.qcom \
    fstab.qcom.vendor_ramdisk \
    init.qcom.rc \
    init.target.rc \
    init.nothing.rc \
    init.nt_product.rc \
    init.qcom.factory.rc \
    ueventd.qcom.rc \
    charger_fw_fstab.qti

# Runtime resource overlays (see overlay/README.md)
PRODUCT_PACKAGES += \
    CarrierConfigOverlayMetroid \
    MetroidConnectivityOverlay \
    MetroidTetheringOverlay \
    MetroidWifiOverlay \
    NTSystemUIResTarget \
    MetroidFrameworksResOverlay \
    MetroidSettingsOverlay \
    MetroidTelephonyOverlay \
    MetroidApertureOverlay \
    MetroidLineageSdkOverlay

# TODO(dlkm): include the makefile that populates vendor_dlkm/system_dlkm with
# the stock prebuilt kernel-module set from the vendor repo (see BoardConfigCommon).

# OEM otacerts
PRODUCT_EXTRA_RECOVERY_KEYS += \
    $(DEVICE_PATH)/security/otacert

# Enable Fuse Passthrough
PRODUCT_PROPERTY_OVERRIDES += persist.sys.fuse.passthrough.enable=true

# Soong config for the recovery's UFS updater (bsg framework)
SOONG_CONFIG_NAMESPACES += ufsbsg
SOONG_CONFIG_ufsbsg += ufsframework
SOONG_CONFIG_ufsbsg_ufsframework := bsg

# Vendor blobs (generated by setup-makefiles.py from the blobs)
$(call inherit-product-if-exists, vendor/nothing/Metroid/Metroid-vendor.mk)

# Device configs (config.fs copies, vintf fragments, permissions;
# provided by the vintf/configs owner)
$(call inherit-product, $(DEVICE_PATH)/configs/configs.mk)
