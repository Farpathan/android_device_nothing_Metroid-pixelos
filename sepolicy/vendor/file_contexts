# Metroid (Nothing Phone 3) file contexts.
#
# Labels only what neither AOSP nor device/qcom/sepolicy_vndr already labels.
# QTI services (keymint, gatekeeper, weaver, secure_element, authsecret, spu,
# qseecom, identity, gnss, thermal, alarm, c2pa, perf2, lights, display colors,
# servicetracker, pasrmanager, psiclient, minkipcbinder, qrtr-ns, camera
# provider, media c2, qcrilNrd, qccsyshal) come from qva/generic vendor policy,
# adding them here too would only risk conflicting entries.

# Audio: vendor audio framework sockets
/dev/socket/audio_agm_socket_0 u:object_r:audio_socket:s0
/dev/socket/audio_holder_socket_0 u:object_r:audio_socket:s0
/dev/socket/audio_us_socket_0 u:object_r:audio_socket:s0
/dev/socket/audio_us_socket_1 u:object_r:audio_socket:s0

# Block devices
/dev/block/by-name/charger                                       u:object_r:vendor_charge_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/countrycode_[ab]   u:object_r:vendor_custom_ab_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/idmanager_[ab]     u:object_r:vendor_custom_ab_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/vbmeta_vendor_[ab] u:object_r:vendor_custom_ab_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/modemfirmware_[ab] u:object_r:vendor_modem_block_device:s0

# Face: Nothing's face service runs in the standard AOSP face HAL domain
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.face-service\.noth    u:object_r:hal_face_default_exec:s0

# Diag
/data/vendor/diag(/.*)?      u:object_r:minidump_data_file:s0
/data/vendor/diag_mdlog(/.*)? u:object_r:vendor_mdlog_vendor_data_file:s0
/(vendor|system/vendor)/bin/diagcommd u:object_r:vendor_diagcommd_exec:s0

# Fingerprint
/data/vendor/fpc(/.*)?                  u:object_r:fingerprint_vendor_data_file:s0
/data/vendor/fpdata(/.*)?               u:object_r:fingerprint_vendor_data_file:s0
/data/vendor/fpdump(/.*)?               u:object_r:fingerprint_vendor_data_file:s0
/data/vendor/goodix(/.*)?               u:object_r:fingerprint_vendor_data_file:s0
/mnt/vendor/persist/fingerprint(/.*)?   u:object_r:fingerprint_vendor_data_file:s0
/mnt/vendor/persist/goodix(/.*)?        u:object_r:fingerprint_vendor_data_file:s0
/dev/goodix_fp                          u:object_r:vendor_fingerprint_device:s0
/dev/nothing-fp                         u:object_r:vendor_fingerprint_device:s0
/(vendor|system/vendor)/bin/hw/vendor\.nothing\.hardware\.biometrics\.fingerprint-service u:object_r:hal_fingerprint_default_exec:s0

# Haptics
/dev/aw86927_haptic u:object_r:vendor_metroid_haptic_device:s0
/dev/ics_sfdc       u:object_r:vendor_metroid_haptic_device:s0

# QRTR: lookup tool is device-only; qrtr-ns is labelled by sepolicy_vndr
/(vendor|system/vendor)/bin/qrtr-lookup u:object_r:vendor_qrtr_exec:s0

# Sensors: Nothing's multihal name is not the one AOSP labels
/vendor/bin/hw/android\.hardware\.sensors-service\.multihal u:object_r:hal_sensors_default_exec:s0

# Thermal
/data/vendor/thermal(/.*)?  u:object_r:thermal_data_file:s0
/sys/devices/virtual/virtual_temp/shell/data u:object_r:vendor_sysfs_virtual_temp:s0
/sys/class/thermal/thermal_message/wifi_limit          u:object_r:sys_thermal_wifi_limit:s0
/sys/devices/virtual/thermal/thermal_message/wifi_limit u:object_r:sys_thermal_wifi_limit:s0
/sys/powersave(/.*)?        u:object_r:sysfs_power_save:s0

# Charging policy: vendor.noth.hardware.charge AIDL HAL
/(vendor|system/vendor)/bin/hw/vendor\.noth\.hardware\.charge-service u:object_r:vendor_hal_charge_default_exec:s0

# WLAN
/data/vendor/mac_addr(/.*)?   u:object_r:vendor_mac_vendor_data_file:s0
/data/vendor/mbnconfig(/.*)?  u:object_r:vendor_firmware_data_file:s0

# Nothing's camera services. These shipped with no label upstream, so init ran
# them as u:r:init:s0 (or refused to exec them under enforcing). Both are
# ordinary camera providers/clients: give them the standard camera HAL domain.
/(vendor|system/vendor)/bin/hw/vendor\.noth\.hardware\.camera-service u:object_r:hal_camera_default_exec:s0

# Unlabelled vendor binaries carried in the stock dump.
#
# power.stats must resolve: with no IPowerStats, system_server retries the lazy
# service forever and crash-loops, so sys.boot_completed never gets set. AOSP
# labels this domain; it just does not match Nothing's exact binary name.
/(vendor|system/vendor)/bin/hw/android\.hardware\.power\.stats-service u:object_r:hal_power_stats_default_exec:s0
/(vendor|system/vendor)/bin/ft_diag_test u:object_r:vendor_ft_diag_test_exec:s0
/(vendor|system/vendor)/bin/st_getcplc    u:object_r:hal_nfc_default_exec:s0

# Stock HAL services installed under -stock names
/vendor/bin/hw/android\.hardware\.sensors\-service\.multihal-stock           u:object_r:hal_sensors_default_exec:s0
/vendor/bin/hw/android\.hardware\.thermal\-service\.qti-stock                u:object_r:hal_thermal_default_exec:s0
/vendor/bin/hw/android\.hardware\.usb\-service\.qti-stock                    u:object_r:hal_usb_default_exec:s0
/vendor/bin/hw/android\.hardware\.wifi\-service-stock                        u:object_r:hal_wifi_default_exec:s0
/vendor/bin/hw/hostapd-stock                                                 u:object_r:hal_wifi_hostapd_default_exec:s0
/vendor/bin/hw/vendor\.qti\.hardware\.memtrack\-service-stock                u:object_r:hal_memtrack_default_exec:s0
/vendor/bin/hw/vendor\.qti\.hardware\.vibrator\.service-stock                u:object_r:hal_vibrator_default_exec:s0
/vendor/bin/hw/wpa_supplicant-stock                                          u:object_r:hal_wifi_supplicant_default_exec:s0
