# Vendor AIDL services shipped as Nothing/Goodix blobs with no upstream type.
# Without these they land on default_android_service, which AOSP neverallows
# vendor domains to add: the build fails rather than the boot.
type vendor_nothing_camera_postproc_service, hal_service_type, protected_service, service_manager_type;
type vendor_goodix_fingerprint_service, hal_service_type, protected_service, service_manager_type;
type vendor_nothing_ntcam_service, hal_service_type, protected_service, service_manager_type;
type vendor_hal_noth_charge_service, hal_service_type, protected_service, service_manager_type;
