# Factory diag test tool, shipped with no SELinux label. It does not block boot,
# but with no domain init refuses to exec it under enforcing, so it would
# silently never run.
#
# Minimal domain: enough to exec and log. Anything else it needs will show up as
# a denial and can be added deliberately rather than granting broad access.
type vendor_ft_diag_test, domain;
type vendor_ft_diag_test_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_ft_diag_test)
