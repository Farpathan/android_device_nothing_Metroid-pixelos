# Metroid (Nothing Phone 3) property types.
#
# Anything read/written by vendor domains needs its own type here: AOSP
# neverallows forbid vendor domains from touching default_prop, so names the
# stock policy left untyped must be given vendor types, never grants on
# default_prop.

# Camera
vendor_public_prop(vendor_camera_p3enable_prop)
vendor_public_prop(vendor_camera_sensor_prop)
vendor_public_prop(vendor_camera_xdrversion_prop)

# Fingerprint
vendor_public_prop(vendor_fp_prop)

# Haptics
vendor_public_prop(vendor_metroid_sfdc_prop)
vendor_internal_prop(vendor_metroid_haptic_calibration_prop)

# RIL OEM identifiers (IMEI/MEID/PSN read by rild)
vendor_public_prop(vendor_deviceid_prop)
vendor_public_prop(vendor_sno_prop)

# Thermal
vendor_public_prop(vendor_thermal_normal_prop)

# Fingerprint HAL runtime props (goodix). persist.vendor.overlay.fp_{model,vendor}
# are set at runtime by hal_fingerprint_default; the system-namespace names it
# also touches (gf.debug.fp_serial) cannot be labelled from vendor
# property_contexts and are dontaudited in enforcing.te.
vendor_internal_prop(vendor_fingerprint_prop)

# Nothing face HAL configuration. Stock calls this vendor_face_config_prop;
# keep a device-local name in the rebuilt vendor policy.
vendor_internal_prop(vendor_face_prop)
