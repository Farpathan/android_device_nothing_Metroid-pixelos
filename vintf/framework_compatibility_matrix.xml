<?xml version="1.0" encoding="UTF-8"?>
<!--
    Nothing Phone (3) / Metroid - framework compatibility matrix extension
    (DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE).

    The framework matrix of Android only knows android.hardware.* HALs. Every
    vendor-specific HAL this device declares in vintf/manifest.xml must also be
    added here or assemble_vintf rejects the manifest ("not in the compatibility
    matrix"). All entries are optional="true": the framework MAY use them, it does
    not require them (a device is free not to serve e.g. IMS or the satellite HAL).

    android.hardware.* entries are intentionally absent: FCM 202404 already covers
    them, and duplicating them here would only drift.

    GENERATED from vintf/manifest.xml. Edit that file, not this one.
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.sensorscalibrate</name>
        <interface>
            <name>ISensorsCalibrate</name>
            <instance>default</instance>
        </interface>
    </hal>

    <hal format="aidl" optional="true">
        <name>vendor.qti.hardware.spu</name>
        <version>2</version>
        <interface>
            <name>ISPUManager</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
