<?xml version="1.0" encoding="UTF-8"?>
<!--
    Nothing Phone (3) / Metroid - device HAL manifest (DEVICE_MANIFEST_FILE).

    Rule: declare every HAL whose stock service calls servicemanager
    addService(); an undeclared AIDL HAL makes the service abort/crash-loop.
    Do NOT declare HALs that a blob fragment already ships:
      * vendor.qti.qccvndhal_aidl   -> vendor/etc/vintf/manifest/ (blob)
      * vendor.qti.qccsyshal_aidl   -> system_ext/etc/vintf/manifest/ (blob,
                                       type="framework"; not a device HAL)

    target-level 202404 is the FCM level of the stock vendor image. Every
    android.hardware.* entry below is checked against that FCM at build time;
    vendor.* / com.nothing.* entries are covered by
    framework_compatibility_matrix.xml.

    Versions are the AIDL interface versions shipped in the stock dump
    (android.hardware.<name>-V<n>-ndk.so), except mapper, a native HAL.

    Deliberately NOT declared (no serving binary or service in the stock dump):
      android.hardware.soundtrigger3   (lib only, no service)
      android.hardware.vibrator        (lib + hw/vibrator.default.so only, no service)
      android.hardware.tetheroffload   (lib only, no service)
      android.hardware.security.keymint/strongbox (odm overlay sku only)
      android.hardware.radio.ims       (no android.hardware.radio.ims-V*-ndk.so)
      vendor.qti.hardware.ListenSoundModel (not served, see old attempt notes)
-->
<manifest version="1.0" type="device" target-level="202404">

