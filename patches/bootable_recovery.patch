+// KeyMint binds keys to the OS version and patch levels it starts with, so they must match the installed ROM
+static bool Sync_KeyMint_Props() {
+	bool changed = false;
+	auto sync = [&changed](const std::string& prop, const std::string& value) {
+		if (value.empty() || android::base::GetProperty(prop, "") == value)
+			return;
+		LOGINFO("Setting %s to '%s' from the installed ROM\n", prop.c_str(), value.c_str());
+		TWFunc::Property_Override(prop, value);
+		changed = true;
+	};
+	sync("ro.build.version.release", TWFunc::System_Property_Get("ro.build.version.release"));
+	sync("ro.build.version.security_patch", TWFunc::System_Property_Get("ro.build.version.security_patch"));
+	sync("ro.vendor.build.security_patch",
+		TWFunc::Partition_Property_Get("ro.vendor.build.security_patch", PartitionManager, "/vendor", "build.prop"));
+	sync("ro.vendor.boot_security_patch",
+		TWFunc::Partition_Property_Get("ro.vendor.boot_security_patch", PartitionManager, "/vendor", "build.prop"));
+	return changed;
+}
+
+// KeyMint and Gatekeeper run from /vendor and TWPartition::UnMount stops them to release it
+static void Start_Crypto_Services() {
+	for (const char* path : {"/vendor", "/odm"}) {
+		TWPartition* part = PartitionManager.Find_Partition_By_Path(path);
+		if (part != nullptr && !part->Is_Mounted())
+			part->Mount(false);
+	}
+	if (Sync_KeyMint_Props() && android::base::GetProperty("init.svc.vendor.keymint-qti", "") == "running") {
+		property_set("ctl.stop", "vendor.keymint-qti");
+		android::base::WaitForProperty("init.svc.vendor.keymint-qti", "stopped", std::chrono::seconds(3));
+	}
+	bool restarted = false;
+	for (const char* svc : {"qseecomd", "vendor.gatekeeper_default", "vendor.keymint-qti"}) {
+		std::string prop = std::string("init.svc.") + svc;
+		if (android::base::GetProperty(prop, "") == "running")
+			continue;
+		LOGINFO("Starting %s\n", svc);
+		property_set("ctl.start", svc);
+		android::base::WaitForProperty(prop, "running", std::chrono::seconds(3));
+		restarted = true;
+	}
+	// keystore2 keeps a binder to the KeyMint instance it first connected to
+	if (restarted) {
+		LOGINFO("Restarting keystore2\n");
+		property_set("ctl.restart", "keystore2");
+	} else if (android::base::GetProperty("init.svc.keystore2", "") != "running") {
+		property_set("ctl.start", "keystore2");
+	}
+	android::base::WaitForProperty("init.svc.keystore2", "running", std::chrono::seconds(3));
+	usleep(200000);
+}
